COMPOSE_PROJECT_NAME=php-devforge
COMPOSE_FILE=docker-compose.yml:docker-compose.override.yml

#### domain ####
DEV_DOMAIN=phpforge.dev

##### USER #####
USERNAME=${USER}

##### DB CREDENTIALS (postgresql, mysql...) #####
USER_DEV=php-devforge
PASSWD_DEV=php-devforge01

##### LOCAL DNS PORT #####
# Port on 127.0.0.1 where dnsmasq listens. Not 53: it is usually taken
# (systemd-resolved, Pi-hole). Change it if 5354 is busy on your machine.
DNS_PORT=5354

##### DEFAULT PHP VERSION #####
PHP_VERSION=84

##### NODE VERSION (built into the PHP images) #####
# Changing this needs a rebuild: docker compose build php83dev php84dev
NODE_VERSION=24

##### PHP XDEBUG #####
XDEBUG_ENABLE=no
#XDEBUG_ENABLE=yes
XDEBUG_IDKEY=PHPDEVFORGE
