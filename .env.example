# Copy to .env, or let ./install.sh generate it for you.
# .env is gitignored: it holds your machine's own values.

COMPOSE_PROJECT_NAME=php-devforge
# ./install.sh appends docker-compose.local.yml here once it has created that file.
# Compose errors on a file that is listed but missing, so it is not listed by default.
COMPOSE_FILE=docker-compose.yml:docker-compose.override.yml

#### domain ####
DEV_DOMAIN=phpforge.dev

##### WHERE YOUR PROJECTS LIVE (on the host) #####
# Mounted at /home/php-devforge/public_html inside the containers, which is where
# Apache and PHP look. Only this side changes; the container path is fixed.
# Symlinks must point INSIDE this folder, or the container cannot follow them.
PROJECTS_DIR=${HOME}/php-devforge

##### USER #####
USERNAME=${USER}

##### DB CREDENTIALS (postgresql, mysql...) #####
USER_DEV=php-devforge
PASSWD_DEV=php-devforge01

##### LOCAL DNS PORT #####
# Port on 127.0.0.1 where dnsmasq listens. Not 53: it is usually taken
# (systemd-resolved, Pi-hole). Change it if 5354 is busy on your machine.
DNS_PORT=5354

##### DEFAULT PHP VERSION #####
PHP_VERSION=84

##### HOST USER #####
# The PHP containers adopt this uid/gid, so files they create are yours and
# node_modules can be deleted without sudo. Check yours with: id -u ; id -g
PUID=1000
PGID=1000

##### IMAGES: pull or build? #####
# missing  use the published images, build only if they cannot be pulled (default)
# build    always build locally -- pick this if you edit anything in docker-library/
# always   re-pull every time, to force the newest published image
#
# Switching is just changing this line and running `docker compose up -d`.
IMAGE_MODE=missing

##### NODE VERSION #####
# Baked into the PHP images at build time, so a pulled image already has it
# fixed. Changing this only takes effect if you build locally:
#   docker compose build php83dev php84dev php85dev
NODE_VERSION=24

##### PHP XDEBUG #####
XDEBUG_ENABLE=no
#XDEBUG_ENABLE=yes
XDEBUG_IDKEY=PHPDEVFORGE
