/.vscode
/elasticsearch
/certificates/*
!/certificates/.gitkeep
/.caroot

/.env

# Your own customisations. Kept out of git so `git pull` never conflicts.
/docker-compose.local.yml
/custom/php.d/*
!/custom/php.d/.gitkeep
# Per-version settings: custom/8.3/php.d/*.ini and anything else you put there.
# The folders themselves are tracked so a fresh clone can mount them.
/custom/[0-9].[0-9]*/**
!/custom/[0-9].[0-9]*/php.d/
!/custom/[0-9].[0-9]*/php.d/.gitkeep
/custom/*/Dockerfile

# Generated by `forge tunnel`, and the mapping it is generated from. Neither
# belongs to anyone but this machine.
/custom/cloudflared/*
!/custom/cloudflared/.gitkeep
/.env.backup
