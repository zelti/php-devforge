#!/usr/bin/env bash
#
# PHP DevForge command line.
#
# Works in any shell, unlike the aliases it replaces: those only worked in bash.
#
set -euo pipefail

# Where you were when you typed the command. `forge run` and `forge shell` map
# it into the container, and the cd below loses it -- which is why the case in
# cmd_shell that was meant to keep your directory never once matched.
INVOCATION_DIR="$PWD"
FORGE_DIR="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
cd "$FORGE_DIR"

# shellcheck source=lib/compose.sh
. ./lib/compose.sh
# shellcheck source=lib/version.sh
. ./lib/version.sh
# shellcheck source=lib/skill.sh
. ./lib/skill.sh

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; BLUE='\033[0;34m'; NC='\033[0m'
info() { echo -e "${GREEN}[OK]${NC} $1"; }
warn() { echo -e "${YELLOW}[!]${NC} $1"; }
err()  { echo -e "${RED}[ERROR]${NC} $1" >&2; }

# X.Y.Z, compared field by field. Not `sort -V`: GNU sort has it, the BSD sort
# macOS ships does not, and this project cares about that (see cmd_link).
version_lt() {
    local i; local -a af bf
    IFS=. read -r -a af <<<"$1"
    IFS=. read -r -a bf <<<"$2"
    for i in 0 1 2; do
        local x="${af[i]:-0}" y="${bf[i]:-0}"
        [ "$x" -lt "$y" ] && return 0
        [ "$x" -gt "$y" ] && return 1
    done
    return 1
}

UPDATE_CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/php-devforge/update-check"

# A background, non-blocking peek at whether a newer release exists. The
# network call (if any) never runs in the foreground -- this reads only
# whatever the last background check already found, refreshed at most once a
# day, so no command ever waits on it. Silent outside a real terminal, so a
# piped/scripted `forge` never gets a stray line mixed into its output.
check_for_update() {
    local now cached_at="" cached_v=""
    now="$(date +%s)"

    if [ -f "$UPDATE_CACHE" ]; then
        IFS=$'\t' read -r cached_at cached_v < "$UPDATE_CACHE" 2>/dev/null || true
    fi

    if [ -z "$cached_at" ] || [ "$((now - cached_at))" -gt 86400 ]; then
        (
            mkdir -p "$(dirname "$UPDATE_CACHE")" 2>/dev/null
            # Prerelease tags (v0.3.0-beta.1) are filtered before head -1, not
            # after: git's version sort ranks them ABOVE the real release they
            # precede, so without this, a real v0.3.0 sitting right there in
            # the list would never even be considered the moment a beta tag
            # existed at all.
            latest="$(git -C "$FORGE_DIR" fetch origin --tags --quiet 2>/dev/null \
                && git -C "$FORGE_DIR" tag -l 'v*' --sort=-v:refname 2>/dev/null \
                | grep -vE -- '-' | head -1)"
            if printf '%s' "$latest" | grep -qE '^v[0-9]+\.[0-9]+\.[0-9]+$'; then
                tmp="$(mktemp "${UPDATE_CACHE}.XXXXXX" 2>/dev/null)" && {
                    printf '%s\t%s\n' "$(date +%s)" "${latest#v}" > "$tmp"
                    mv "$tmp" "$UPDATE_CACHE"
                }
            fi
        ) >/dev/null 2>&1 &
    fi

    if [ -n "$cached_v" ] && [ -t 1 ]; then
        local current; current="$(cat "$FORGE_DIR/VERSION" 2>/dev/null || echo 0.0.0)"
        version_lt "$current" "$cached_v" \
            && warn "A new version is available: v${cached_v} (you have ${current}). Run: forge update"
    fi
    return 0
}

# Accepts 8.5 or 85; returns the compact form.
normalise() {
    local v="${1//./}"
    if ! grep -qx "$v" <<<"$(php_versions)"; then
        err "Unknown PHP version: $1"
        echo "  available: $(php_versions | sed 's/\(.\)\(.\)/\1.\2/' | tr '\n' ' ')" >&2
        exit 1
    fi
    echo "$v"
}

current_version() { sed -ne 's/^PHP_VERSION=\([0-9]*\)$/\1/p' .env 2>/dev/null; }

# Absent in .env files written before the setting existed; compose defaults it too.
image_mode() {
    local m; m="$(sed -ne 's/^IMAGE_MODE=//p' .env 2>/dev/null)"
    echo "${m:-missing (default)}"
}

need_env() {
    [ -f .env ] || { err "No .env here. Run ./install.sh first."; exit 1; }
    ensure_php_profiles
}

# PHP versions became profiles in task 41. Before that every version ran, so a
# COMPOSE_PROFILES with no php entry can only be an older .env: keep everything
# it used to have rather than silently dropping two versions. The write makes
# this a one-time notice.
ensure_php_profiles() {
    grep -qE '^php[0-9][0-9]$' <<<"$(enabled_profiles)" && return 0
    local versions keep add
    versions="$(php_versions)"
    [ -n "$versions" ] || return 0
    keep="$(enabled_profiles)"
    add="$(printf 'php%s\n' $versions)"
    write_profiles $keep $add
    warn "PHP versions are now picked, like the databases."
    echo "    Kept the ones you had: $(printf '%s\n' "$versions" | pretty | commas)"
    echo "    Drop the ones you do not use:  forge php list"
}

# A version is installed when its profile is on. Anything else is a 2 GB image
# that was never pulled.
need_php() {
    is_on "php$1" && return 0
    err "PHP $(printf '%s' "$1" | pretty) is not installed."
    echo "  Install it:  forge php on $(printf '%s' "$1" | pretty)" >&2
    exit 1
}

# Every checkout claims the same compose project, so containers started from
# another directory look like ours -- `up -d` here silently adopts and
# reconfigures them. That is not destructive, but it is never what you meant.
check_owner() {
    local owner; owner="$(active_dir)"
    [ -n "$owner" ] || return 0
    [ "$owner" != "$FORGE_DIR" ] || return 0

    warn "These containers were started from:"
    echo "      $owner" >&2
    echo "    Continuing will reconfigure them from here." >&2
    echo "    To go back:  cd $owner && forge start" >&2
    echo "" >&2

    if [ "$FORCE" = "1" ]; then
        warn "Taking over (--force)"
        return 0
    fi
    if [ ! -t 0 ]; then
        err "No terminal to ask on. Use 'forge --force <command>' to take over."
        exit 1
    fi
    local answer
    read -r -p "    Take them over? [y/N]: " answer </dev/tty || answer=""
    case "$answer" in
        [yY]*) return 0 ;;
        *) err "Left alone."; exit 1 ;;
    esac
}

# nginx replaces apachedev rather than joining it -- they publish the same
# 80/443 -- but apachedev is in the default set, so a plain `up -d` starts it
# again and the two race for the port. Every start goes through here.
#
# The pipelines in this file avoid `producer | grep -q`: grep exits at the first
# match, the producer dies of EPIPE, and pipefail turns a match into a failure.
# It made `forge mail on` answer "Unknown profile: mail" while listing mail as
# available. Here-strings have no pipe.
# The ${a[@]+...} form is for bash 3.2 on macOS, where an empty array under
# `set -u` is an error.
compose_up() {
    check_owner
    ensure_custom_dirs
    # --scale applies to the set being started, so compose rejects it outright
    # when specific services are named: `forge restart nginxdev` failed with
    # "no such service: apachedev: disabled", exited 1 and recreated nothing.
    # Naming a service means "just this one", and apachedev is not in that set.
    local extra=() a named=0
    for a in "$@"; do case "$a" in -*) ;; *) named=1 ;; esac; done
    if [ "$named" -eq 0 ] && is_on nginx; then extra=(--scale apachedev=0); fi
    docker compose up -d "${extra[@]+"${extra[@]}"}" "$@"
}

pretty() { sed 's/\(.\)\(.\)/\1.\2/'; }

cmd_start()   { need_env; compose_up "$@"; }
cmd_stop()    { need_env; check_owner; docker compose stop "$@"; }
cmd_restart() { need_env; compose_up --force-recreate "$@"; }

cmd_status() {
    need_env
    echo -e "${BLUE}PHP DevForge${NC} $(forge_version)"
    echo "  domain:   *.$(sed -ne 's/^DEV_DOMAIN=//p' .env)"
    echo "  php:      $(installed_versions | pretty | commas)  (default $(current_version | pretty))"
    echo "  images:   $(image_mode)"
    echo "  projects: $(sed -ne 's/^PROJECTS_DIR=//p' .env)"
    local owner; owner="$(active_dir)"
    if [ -n "$owner" ] && [ "$owner" != "$FORGE_DIR" ]; then
        echo "  running:  from $owner  (another checkout)"
    fi
    echo ""
    docker compose ps
}

cmd_use() {
    need_env
    [ $# -ge 1 ] || { err "Which version? e.g. forge use 8.5"; exit 1; }
    local v; v="$(normalise "$1")"
    if ! is_on "php$v"; then
        info "PHP $(echo "$v" | pretty) is not installed yet; adding it"
        local keep; keep="$(enabled_profiles)"
        write_profiles $keep "php$v"
    fi
    sed -i "s/^PHP_VERSION=.*/PHP_VERSION=${v}/" .env
    info "Default is now PHP $(echo "$v" | pretty)"
    compose_up
}

# The projects folder is bind-mounted at a fixed path inside every container, so
# a host directory has to be translated before docker exec sees it. Passing $PWD
# straight through is what made `forge shell` die inside a project with
# `chdir to cwd ... no such file or directory`.
CONTAINER_ROOT="/home/php-devforge/public_html"

projects_dir() { sed -ne 's/^PROJECTS_DIR=//p' .env 2>/dev/null; }

# Both sides resolved with -P: sites/ is a folder of symlinks into projects/, and
# the two spellings of the same directory have to land on the same answer.
container_path() { # host dir -> container dir; 1 when it is outside
    local root abs
    root="$(projects_dir)"
    [ -n "$root" ] || return 1
    root="$(cd "$root" 2>/dev/null && pwd -P)" || return 1
    abs="$(cd "$1" 2>/dev/null && pwd -P)" || return 1
    case "$abs" in
        "$root")   printf '%s\n' "$CONTAINER_ROOT" ;;
        "$root"/*) printf '%s\n' "$CONTAINER_ROOT/${abs#"$root"/}" ;;
        *) return 1 ;;
    esac
}

need_running() { # container
    # Here-string, not a pipe: see the note on compose_up.
    grep -qx "$1" <<<"$(docker ps --format '{{.Names}}' 2>/dev/null)" && return 0
    err "$1 is not running."
    echo "  Start it:  forge start" >&2
    exit 1
}

cmd_shell() {
    need_env
    local v; v="$(normalise "${1:-$(current_version)}")"
    need_php "$v"
    need_running "php${v}dev"
    # Keep your current directory when you are inside the projects folder.
    local wd; wd="$(container_path "$INVOCATION_DIR")" || wd="/home/php-devforge"
    docker exec -it -w "$wd" -u php-devforge "php${v}dev" bash
}

# What `forge shell` is for scripts, and the reason this command exists: the
# hand-written form has to know the container path, the user, that node and pnpm
# only exist in a login shell, and that -it must be dropped when there is no
# terminal. Getting any of the four wrong fails in a way that reads like a
# problem with your project.
cmd_run() {
    need_env
    local v="" dir=""
    while [ $# -gt 0 ]; do
        case "$1" in
            -p|--php) v="${2:-}"; shift 2 ;;
            -p*)      v="${1#-p}"; shift ;;
            -C|--dir) dir="${2:-}"; shift 2 ;;
            --)       shift; break ;;
            -*) err "Unknown option: $1"
                echo "  usage: forge run [-p VERSION] [-C DIR] <command>..." >&2; exit 1 ;;
            *) break ;;
        esac
    done
    [ $# -ge 1 ] || { err "What should I run? e.g. forge run composer install"; exit 1; }

    v="$(normalise "${v:-$(current_version)}")"
    need_php "$v"
    need_running "php${v}dev"

    local wd root; root="$(projects_dir)"
    if [ -n "$dir" ]; then
        case "$dir" in /*) ;; *) dir="$root/$dir" ;; esac
        wd="$(container_path "$dir")" || {
            err "No such folder under $root: $dir"; exit 1; }
    else
        wd="$(container_path "$INVOCATION_DIR")" || {
            err "You are not inside $root, so there is no project to run this in."
            echo "  cd into it, or name it:  forge run -C projects/my-app $1 ..." >&2
            exit 1
        }
    fi

    # %q keeps arguments that contain spaces intact through the login shell.
    local cmdline; cmdline="$(printf '%q ' "$@")"
    # -t only with a terminal on both ends: with it, captured output carries
    # escape codes, and `docker exec -it` under a pipe fails outright.
    local tty=(); [ -t 0 ] && [ -t 1 ] && tty=(-t)
    exec docker exec -i "${tty[@]+"${tty[@]}"}" -u php-devforge -w "$wd" \
         "php${v}dev" bash -lc "$cmdline"
}

# No argument means every service: when something breaks you rarely know which
# container to look at, and picking one for you is how `docker compose logs`
# ended up in the troubleshooting section instead of this command.
cmd_logs() {
    need_env
    local arg="${1:-}"
    if [ -z "$arg" ]; then
        docker compose logs -f
    elif grep -qE '^[0-9]+\.?[0-9]+$' <<<"$arg"; then
        local v; v="$(normalise "$arg")"
        need_php "$v"
        docker compose logs -f "php${v}dev"
    else
        # Plain compose here, not compose_with_env: that one clears
        # COMPOSE_PROFILES, which would hide mailpit and the databases.
        grep -qx "$arg" <<<"$(docker compose config --services)" || {
            err "Unknown service: $arg"
            echo "  available: $(docker compose config --services | sort | paste -sd' ' -)" >&2
            exit 1
        }
        docker compose logs -f "$arg"
    fi
}

cmd_mail() {
    need_env
    case "${1:-status}" in
        on)  cmd_profile on mail
             info "Mail catcher at https://mail.$(sed -ne 's/^DEV_DOMAIN=//p' .env)"
             echo "  Point your app's SMTP at mailpit:1025 (no auth, no TLS)" ;;
        off) cmd_profile off mail ;;
        status|"")
             if is_on mail; then echo "  mail: ON"; else echo "  mail: off"; fi ;;
        *) err "forge mail [on|off|status]"; exit 1 ;;
    esac
}

cmd_images() {
    need_env
    case "${1:-}" in
        build)  sed -i 's/^IMAGE_MODE=.*/IMAGE_MODE=build/' .env
                info "Images will be built locally"; compose_up ;;
        pull)   sed -i 's/^IMAGE_MODE=.*/IMAGE_MODE=missing/' .env
                info "Images will be pulled from ghcr.io"; compose_up ;;
        status|"") echo "  IMAGE_MODE=$(image_mode)" ;;
        *) err "forge images [build|pull|status]"; exit 1 ;;
    esac
}

cmd_install() { ./install.sh "$@"; }

# Delegated for the same reason as install: the script has to keep working
# after this command's own symlink is gone.
cmd_uninstall() { ./uninstall.sh "$@"; }

# Lands on a release tag, not a moving branch: everybody who updates ends up
# on the same commit, and `forge version` (git describe) is built to report a
# bare tag cleanly. --edge is the escape hatch for whoever wants main instead.
cmd_update() {
    local edge=0 do_stash=0 arg
    for arg in "$@"; do
        case "$arg" in
            --edge)  edge=1 ;;
            --stash) do_stash=1 ;;
            *) err "usage: forge update [--edge] [--stash]"; exit 1 ;;
        esac
    done

    git rev-parse --is-inside-work-tree >/dev/null 2>&1 || {
        err "Not a git checkout -- nothing to update."
        exit 1
    }

    info "Checking for updates"
    git fetch origin --tags --quiet

    # Untracked files are not this check's business -- .env, custom/, and the
    # rest are already gitignored for exactly this reason. A tracked file the
    # user edited directly is the one case worth stopping for.
    local dirty; dirty="$(git status --porcelain --untracked-files=no)"
    if [ -n "$dirty" ]; then
        if [ "$do_stash" -eq 1 ]; then
            warn "Stashing local changes"
            git stash push -m "forge update autostash" >/dev/null
        else
            err "You have local changes -- refusing to update over them."
            echo "$dirty" | sed 's/^/  /' >&2
            if grep -q 'docker-library/' <<<"$dirty"; then
                echo "  docker-library/ changes with every release -- see the README's" >&2
                echo "  note on customising without breaking upgrades." >&2
            fi
            echo "  Stash them and update anyway:  forge update --stash" >&2
            exit 1
        fi
    fi

    if [ "$edge" -eq 1 ]; then
        git checkout main --quiet
        git pull --ff-only origin main
        info "On main: $(forge_version)"
    else
        local target
        # Prerelease tags (v0.3.0-beta.1) are filtered before head -1, not
        # after: git's version sort ranks them ABOVE the real release they
        # precede, so plain `forge update` would otherwise land someone on a
        # beta they never asked for. --edge, above, does not go through this
        # at all -- it tracks main regardless.
        target="$(git tag -l 'v*' --sort=-v:refname | grep -vE -- '-' | head -1)"
        [ -n "$target" ] || { err "No release tags found."; exit 1; }

        # ^{commit}: an annotated tag's own sha differs from the commit it
        # points at, so comparing rev-parse output raw never matched, and
        # forge update re-"updated" to where it already was, every time.
        if [ "$(git rev-parse HEAD)" = "$(git rev-parse "${target}^{commit}")" ]; then
            info "Already on the latest release: $target"
        else
            git checkout "$target" --quiet
            info "Updated to $target"
            warn "You're on a specific release now, not a branch -- that's expected."
            echo "      forge update --edge tracks main instead, if you want that."
        fi
    fi

    if [ "$do_stash" -eq 1 ] && [ -n "$dirty" ]; then
        warn "Restoring your local changes"
        git stash pop || warn "Could not reapply automatically -- see: git stash list"
    fi

    if [ -f .env ]; then
        info "Reconciling .env"
        ./install.sh -y
    fi

    echo ""
    echo "  Docker images use a floating ':dev' tag and are not refreshed by this."
    echo "  Force one:  docker compose pull   (or set IMAGE_MODE=always in .env)"
}

# Optional services are compose profiles listed in COMPOSE_PROFILES, so `forge
# profile` just edits that line. Nothing here enumerates them: the list comes
# from the compose files, so adding postgres 19 means adding a service.
profile_list() {
    local out; out="$(all_profiles)" || {
        err "Could not read the compose profiles."
        echo "  Check it by hand:  docker compose config --profiles" >&2
        exit 1
    }
    printf '%s\n' "$out"
}

db_profiles() { profile_list | grep -E '^(pg[0-9]+|mariadb[0-9]+)$' || true; }

# The versions actually installed, as 83/84 -- php_versions() lists every one the
# compose files define, installed or not.
installed_versions() { enabled_profiles | sed -n 's/^php\([0-9][0-9]\)$/\1/p' | sort; }

is_on() { grep -qx "$1" <<<"$(enabled_profiles)"; }

# Two profiles are not plain add-ons, and saying so beats parsing YAML for it:
# nginx publishes the same 80/443 as apachedev (docker-compose.yml:69,109), and
# tools is a one-shot mkcert run with nothing left running afterwards.
profile_note() {
    case "$1" in
        nginx) echo "replaces apachedev" ;;
        tools) echo "used by forge certs" ;;
        "php$(current_version)") echo "default: answers host names with no --pNN" ;;
    esac
}

enabled_profiles() {
    sed -ne 's/^COMPOSE_PROFILES=//p' .env 2>/dev/null | tr ',' '\n' | grep -v '^$' || true
}

write_profiles() {
    local joined; joined="$(printf '%s\n' "$@" | grep -v '^$' | sort -u | paste -sd, - || true)"
    if grep -q '^COMPOSE_PROFILES=' .env; then
        sed -i "s|^COMPOSE_PROFILES=.*|COMPOSE_PROFILES=${joined}|" .env
    else
        printf '\nCOMPOSE_PROFILES=%s\n' "$joined" >> .env
    fi
}

cmd_profile() {
    need_env
    local action="${1:-list}" name="${2:-}"
    case "$action" in
        list)
            local filter="${2:-}" state note
            compose_cache        # one read; the subshells below inherit it
            profile_list | while read -r p; do
                [ -n "$p" ] || continue
                case "$p" in *"$filter"*) ;; *) continue ;; esac
                if [ "$p" = tools ]; then state="-"
                elif is_on "$p";  then state="ON"
                else                   state="off"; fi
                note="$(profile_note "$p")"
                printf '  %-11s %-4s %-42s %s\n' "$p" "$state" "$(profile_images "$p")" "$note"
            done
            ;;
        on|off)
            [ -n "$name" ] || { err "which one? try: forge profile list"; exit 1; }
            grep -qx "$name" <<<"$(profile_list)" || {
                err "Unknown profile: $name"
                echo "  available: $(profile_list | paste -sd' ' -)" >&2; exit 1; }

            if [ "$name" = tools ] && [ "$action" = on ]; then
                err "'tools' runs mkcert once and exits; there is nothing to keep on."
                echo "  You want:  forge certs" >&2; exit 1
            fi

            local keep; keep="$(enabled_profiles | grep -vx "$name" || true)"
            if [ "$action" = on ]; then
                write_profiles $keep "$name"
                if [ "$name" = nginx ]; then
                    warn "apachedev goes down: nginx wants the same ports"
                fi
                compose_up
                info "$name on   ->  $(profile_services "$name" | commas)"
            else
                write_profiles $keep
                profile_services "$name" | while read -r svc; do
                    [ -n "$svc" ] && docker compose stop "$svc" >/dev/null 2>&1 || true
                done
                compose_up
                if [ "$name" = nginx ]; then info "apachedev is back"; fi
                info "$name off"
            fi
            ;;
        *) err "forge profile [list [filter]|on <name>|off <name>]"; exit 1 ;;
    esac
}

# Kept because they read well, and the installer and READMEs already name them.
cmd_db() {
    need_env
    local action="${1:-list}" name="${2:-}"
    case "$action" in
        list)
            db_profiles | while read -r p; do
                [ -n "$p" ] || continue
                if is_on "$p"; then echo "    $p  ON"; else echo "    $p  off"; fi
            done
            ;;
        on|off)
            [ -n "$name" ] || { err "which one? try: forge db list"; exit 1; }
            grep -qx "$name" <<<"$(db_profiles)" || {
                err "Unknown database: $name"
                echo "  available: $(db_profiles | paste -sd' ' -)" >&2; exit 1; }
            cmd_profile "$action" "$name"
            ;;
        *) err "forge db [list|on <name>|off <name>]"; exit 1 ;;
    esac
}

# Versions are profiles too, so this reads like `forge db`. The extra rule is the
# default: something has to answer a host name with no --pNN suffix.
cmd_php() {
    need_env
    local action="${1:-list}" name="${2:-}" v def
    def="$(current_version)"
    case "$action" in
        list)
            php_versions | while read -r p; do
                [ -n "$p" ] || continue
                if   [ "$p" = "$def" ]; then printf '    %-5s ON    default\n' "$(printf '%s' "$p" | pretty)"
                elif is_on "php$p";     then printf '    %-5s ON\n'            "$(printf '%s' "$p" | pretty)"
                else                         printf '    %-5s off   about 2 GB to install\n' "$(printf '%s' "$p" | pretty)"
                fi
            done
            ;;
        on|off)
            [ -n "$name" ] || { err "which version? try: forge php list"; exit 1; }
            v="$(normalise "$name")"
            if [ "$action" = off ] && [ "$v" = "$def" ]; then
                err "PHP $(printf '%s' "$v" | pretty) is the default; nothing would answer a plain host name."
                echo "  Point the default elsewhere first:  forge use <version>" >&2
                exit 1
            fi
            cmd_profile "$action" "php$v"
            ;;
        *) err "forge php [list|on <version>|off <version>]"; exit 1 ;;
    esac
}

# Publishing a project is making a symlink under sites/. Doing it by hand means
# getting a relative path right from the wrong directory, which is easy to botch.
cmd_link() {
    need_env
    local target="${1:-}" name="${2:-}"
    [ -n "$target" ] || { err "usage: forge link <path-to-public-folder> [name]"; exit 1; }

    local root; root="$(sed -ne 's/^PROJECTS_DIR=//p' .env)"
    local abs; abs="$(cd "$target" 2>/dev/null && pwd)" || { err "No such folder: $target"; exit 1; }

    # The containers only see PROJECTS_DIR, so a link out of it resolves to nothing.
    case "$abs/" in
        "$root"/*) ;;
        *) err "That folder is outside $root, so the containers cannot reach it."; exit 1 ;;
    esac

    [ -f "$abs/index.php" ] || warn "No index.php there; the site will return 403."

    # Frameworks all point at .../public, so the folder name is useless as a site
    # name. Fall back to the project directory above it.
    if [ -z "$name" ]; then
        name="$(basename "$abs")"
        case "$name" in
            public|web|htdocs|public_html|www) name="$(basename "$(dirname "$abs")")" ;;
        esac
    fi
    case "$name" in .*|*/*) err "Bad name: $name"; exit 1 ;; esac

    mkdir -p "$root/sites"
    # Relative, not absolute. The containers mount PROJECTS_DIR at a different path,
    # so an absolute link resolves on the host and points at nothing inside.
    # Both ends live under $root, so "../" plus the remainder is all it takes -- and
    # it avoids `ln -r`, which macOS does not have.
    ln -sfn "../${abs#"$root"/}" "$root/sites/$name"
    info "https://${name}.$(sed -ne 's/^DEV_DOMAIN=//p' .env)"
}

# ── Public tunnels ──────────────────────────────────────────────────────────
#
# Two shapes, and the difference is only whether you hand over credentials:
#
#   forge tunnel [folder]   nobody's account, random *.trycloudflare.com URL,
#                           foreground, gone when you close the window
#   forge tunnel add ...    your own Cloudflare domain, a hostname that stays,
#                           several sites at once, running in the background
#
# Both go to the web server's HTTPS port and not to port 80, and that is the
# whole trick. Reached over plain HTTP the app sees no TLS, so frameworks build
# http:// links while the browser is on https://: mixed content gets blocked, or
# the redirects loop. The usual cure is editing the app's proxy settings, which
# is work this has no business asking for. Over 443 PHP gets HTTPS=on for real
# and nothing in the app needs to change.
#
# The self-signed certificate is not in the way: cloudflared is told not to
# verify it, and no phone ever sees it, because the public TLS is Cloudflare's
# own. The HSTS that Chrome pins on every .dev name never comes up either, since
# the browser is visiting trycloudflare.com or your domain, not .phpforge.dev.
TUNNEL_NAME="php-devforge"
TUNNEL_DIR="custom/cloudflared"
TUNNEL_CONFIG="$TUNNEL_DIR/config.yml"
TUNNEL_SITES="$TUNNEL_DIR/sites"
TUNNEL_IMAGE="cloudflare/cloudflared:latest"
CLOUDFLARED_HOME="${HOME}/.cloudflared"

dev_domain() { sed -ne 's/^DEV_DOMAIN=//p' .env 2>/dev/null; }

# The network compose puts everything on. Named after the project, which is a
# fixed literal in .env rather than the directory name.
compose_network() {
    local p; p="$(sed -ne 's/^COMPOSE_PROJECT_NAME=//p' .env 2>/dev/null)"
    printf '%s_default\n' "${p:-php-devforge}"
}

# nginx replaces apachedev rather than adding to it -- profile_note() says so,
# and both want ports 80 and 443 -- so the tunnel has to follow whichever is on.
# Naming one of them outright is what broke the hand-written script this
# replaces the day someone switched.
web_container() { if is_on nginx; then echo nginxdev; else echo apachedev; fi; }

sites_dir() { printf '%s/sites\n' "$(projects_dir)"; }
published() { ls "$(sites_dir)" 2>/dev/null | tr '\n' ' '; }

# Sibling of sites/, not nested inside it: sites/ is what you publish by
# hand with `forge link`; .tunnel/ is what `forge tunnel` manages on its own,
# and the two should not have to know about each other.
tunnel_dir() { printf '%s/.tunnel\n' "$(projects_dir)"; }

# What to tunnel: an explicit path (exactly like `forge link <path>`), an
# existing sites/ shortcut (kept working as a convenience, never required),
# or -- with no argument -- the directory you are standing in. Unlike the
# need_site() this replaced, it never requires sites/: .tunnel/ points
# straight at the project, so nothing has to be published there first.
tunnel_target() {
    local arg="${1:-.}" root abs
    root="$(sed -ne 's/^PROJECTS_DIR=//p' .env)"

    abs="$(cd "$INVOCATION_DIR" && cd "$arg" 2>/dev/null && pwd)" || {
        if [ -n "${1:-}" ] && [ -e "$(sites_dir)/$1" ]; then
            abs="$(cd "$(sites_dir)/$1" 2>/dev/null && pwd)" || { err "Broken link: sites/$1"; exit 1; }
        else
            err "No such folder: $arg"
            [ -n "${1:-}" ] && echo "  Published:  $(published)" >&2
            exit 1
        fi
    }

    case "$abs/" in
        "$root"/*) ;;
        *) err "That folder is outside $root, so the containers cannot reach it."; exit 1 ;;
    esac

    printf '%s\n' "$abs"
}

# Same naming rule cmd_link uses: frameworks all point at .../public, so the
# folder name alone is useless -- fall back to the project directory above it.
# Cosmetic only here (shown in messages, and as the SNI cloudflared presents);
# nothing in the tunnel mechanism depends on it being unique.
tunnel_name() {
    local name; name="$(basename "$1")"
    case "$name" in
        public|web|htdocs|public_html|www) name="$(basename "$(dirname "$1")")" ;;
    esac
    printf '%s\n' "$name"
}

# --php's argument: a real version, and one actually installed -- otherwise
# the failure would show up later as a broken proxy behind the tunnel instead
# of a clear message now.
tunnel_require_installed() {
    local v; v="$(normalise "$1")"
    grep -qx "$v" <<<"$(installed_versions)" || {
        err "PHP $(pretty <<<"$v") is not installed."
        echo "  Install it:  forge php on $(pretty <<<"$v")" >&2
        exit 1
    }
    printf '%s\n' "$v"
}

# cloudflared against your account. ~/.cloudflared is where it keeps the login
# certificate and one credentials file per tunnel; mounting it read-write is the
# whole reason this wrapper is separate from the read-only one in compose.
tunnel_cf() {
    # mkdir'd here on purpose: a missing bind-mount source is created by the
    # Docker daemon, which runs as root, and cloudflared then cannot write its
    # own cert into a directory it does not own. Running the real command as
    # root sidesteps a mismatch inside the image itself: it declares user
    # 65532 at runtime, but ships /home/nonroot owned by uid 1000, so no
    # single --user satisfies both. HOME is set to match the mountpoint, since
    # that is where cloudflared looks for its cert unless told otherwise.
    mkdir -p "$CLOUDFLARED_HOME"
    local tty=(); [ -t 0 ] && [ -t 1 ] && tty=(-it)
    docker run --rm "${tty[@]+"${tty[@]}"}" \
        --user 0:0 \
        -e HOME=/home/nonroot \
        -v "${CLOUDFLARED_HOME}:/home/nonroot/.cloudflared" \
        "$TUNNEL_IMAGE" "$@"

    # Whatever it just wrote is root's. Handed back with a throwaway
    # container instead of `sudo` on the host -- and made group/other
    # readable too, since the background cloudflared service in
    # docker-compose.override.yml reads these same files as its image's own
    # default user (65532), not yours and not root.
    docker run --rm -v "${CLOUDFLARED_HOME}:/data" alpine \
        sh -c "chown -R $(id -u):$(id -g) /data && chmod -R u+rwX,go+rX /data"
}

need_login() {
    [ -f "${CLOUDFLARED_HOME}/cert.pem" ] && return 0
    err "Not logged in to Cloudflare."
    echo "  Run:  forge tunnel login" >&2
    exit 1
}

# Columns are ID, NAME, CREATED, CONNECTIONS.
tunnel_uuid() {
    tunnel_cf tunnel list 2>/dev/null | awk -v n="$TUNNEL_NAME" '$2 == n { print $1; exit }'
}

# One tunnel serves every site; the ingress rules inside it are what route each
# hostname. A second tunnel would mean a second connection to Cloudflare for no
# gain.
tunnel_ensure() {
    [ -n "$(tunnel_uuid)" ] && return 0
    info "Creating the '${TUNNEL_NAME}' tunnel in your Cloudflare account"
    tunnel_cf tunnel create "$TUNNEL_NAME"
}

# Rewritten whole on every add and rm. Ingress is an ordered list whose last
# entry has to be the catch-all, so editing it in place in bash is a worse idea
# than generating it from the flat mapping in $TUNNEL_SITES.
tunnel_write_config() {
    local uuid web domain name hostname
    uuid="$(tunnel_uuid)"
    web="$(web_container)"
    domain="$(dev_domain)"

    mkdir -p "$TUNNEL_DIR"
    {
        echo "# Written by \`forge tunnel add|rm\`. Rewritten whole each time, so"
        echo "# hand edits here do not survive; change the mapping in ./sites."
        echo "tunnel: ${TUNNEL_NAME}"
        echo "credentials-file: /home/nonroot/.cloudflared/${uuid}.json"
        echo ""
        echo "ingress:"
        while IFS=$'\t' read -r name hostname; do
            [ -n "${name:-}" ] || continue
            echo "  - hostname: ${hostname}"
            # 443 and not 80, and noTLSVerify because of it: see the note above
            # cmd_tunnel. This is what spares every app its proxy settings.
            echo "    service: https://${web}:443"
            echo "    originRequest:"
            echo "      noTLSVerify: true"
            echo "      originServerName: ${name}.${domain}"
        done < "$TUNNEL_SITES"
        echo "  - service: http_status:404"
    } > "$TUNNEL_CONFIG"
}

# .tunnel/ holds one symlink per live public hostname, pointing straight at
# the project it publishes -- what resolve_docroot.lua reads instead of a
# rewritten Host header -- plus one same-named ".php" file next to it when a
# version was pinned with --php. Only entries NOT in $TUNNEL_SITES are swept:
# those are the persistent ones from `tunnel add`, and a quick tunnel's
# cleanup has no business touching them. Also run on start, to sweep whatever
# a window closed the hard way (crash, kill -9) left behind.
tunnel_clean() {
    local dir; dir="$(tunnel_dir)"
    [ -d "$dir" ] || return 0
    local keep=""
    [ -f "$TUNNEL_SITES" ] && keep="$(awk -F'\t' '{print $2}' "$TUNNEL_SITES")"
    local entry base
    for entry in "$dir"/*; do
        [ -e "$entry" ] || continue
        base="$(basename "$entry")"; base="${base%.php}"
        grep -qxF "$base" <<<"$keep" || rm -f "$entry"
    done
}

# Anonymous. Nothing is created, nothing is stored, and it dies with the window.
tunnel_quick() {
    local arg="" ver="" abs name root relpath sni web public_host=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --php) ver="${2:-}"; shift 2 ;;
            *) arg="$1"; shift ;;
        esac
    done
    [ -n "$ver" ] && ver="$(tunnel_require_installed "$ver")"

    abs="$(tunnel_target "$arg")"
    name="$(tunnel_name "$abs")"
    root="$(sed -ne 's/^PROJECTS_DIR=//p' .env)"
    relpath="${abs#"$root"/}"
    sni="${name}.$(dev_domain)"
    web="$(web_container)"

    # The network is the wrong thing to check: it lives as long as any container
    # does, and mailpit and dnsmasq hold it open on their own. So the check the
    # old script made passed while there was nothing to tunnel to, and the
    # failure came later as a name-resolution error that named no cause.
    need_running "$web"

    mkdir -p "$(tunnel_dir)"
    tunnel_clean
    trap tunnel_clean EXIT INT TERM

    warn "This puts ${name} on the public internet, with nothing guarding it."
    echo "  It lasts as long as this window. Ctrl+C closes it."
    echo ""
    info "Tunnelling https://${web}:443"
    echo "  The public URL appears below."
    echo ""

    # Piped through a reader instead of exec'd, so the trycloudflare.com URL can
    # be caught as it goes by and turned into the .tunnel/ symlink. No -it
    # here: cloudflared needs no terminal to run, and docker refuses to
    # allocate one once stdout is a pipe rather than a real tty. The loop runs
    # in a subshell (the pipe causes that), so a variable set inside it --
    # public_host -- would not survive out here; that is why cleanup is a trap
    # on the whole directory rather than on one remembered name.
    docker run --rm \
        --network "$(compose_network)" \
        "$TUNNEL_IMAGE" \
        tunnel --url "https://${web}:443" \
               --origin-server-name "$sni" \
               --no-tls-verify 2>&1 | while IFS= read -r line; do
        echo "$line"
        if [ -z "$public_host" ]; then
            # grep exits 1 on every line that is not the one with the URL --
            # nearly all of them -- and script runs under `set -e`, so an
            # unguarded assignment here would kill the whole tunnel on the
            # first line that doesn't match.
            public_host="$(printf '%s\n' "$line" | grep -oE '[a-z0-9-]+\.trycloudflare\.com' || true)"
            if [ -n "$public_host" ]; then
                ln -sfn "../${relpath}" "$(tunnel_dir)/${public_host}"
                [ -n "$ver" ] && printf '%s\n' "$ver" > "$(tunnel_dir)/${public_host}.php"
            fi
        fi
    done
}

tunnel_add() {
    need_login
    local arg="" host="" ver="" abs name root relpath suffix old_host
    while [ $# -gt 0 ]; do
        case "$1" in
            --php) ver="${2:-}"; shift 2 ;;
            *) if [ -z "$arg" ]; then arg="$1"; else host="$1"; fi; shift ;;
        esac
    done
    [ -n "$ver" ] && ver="$(tunnel_require_installed "$ver")"

    abs="$(tunnel_target "$arg")"
    name="$(tunnel_name "$abs")"
    root="$(sed -ne 's/^PROJECTS_DIR=//p' .env)"
    relpath="${abs#"$root"/}"

    mkdir -p "$TUNNEL_DIR"
    [ -f "$TUNNEL_SITES" ] || : > "$TUNNEL_SITES"

    old_host="$(awk -F'\t' -v s="$name" '$1 == s { print $2; exit }' "$TUNNEL_SITES")"

    if [ -z "$host" ]; then
        # Borrow the shape of whatever is already mapped, so only the first one
        # has to be spelled out.
        suffix="$(awk -F'\t' 'NR==1 { sub(/^[^.]*\./, "", $2); print $2; exit }' "$TUNNEL_SITES")"
        [ -n "$suffix" ] || {
            err "No hostname given, and none to copy the shape from."
            echo "  First one spells it out:  forge tunnel add $name $name.tunnel.yourdomain.com" >&2
            exit 1
        }
        host="${name}.${suffix}"
    fi

    tunnel_ensure

    info "Pointing ${host} at this machine"
    tunnel_cf tunnel route dns "$TUNNEL_NAME" "$host"

    mkdir -p "$(tunnel_dir)"
    if [ -n "$old_host" ] && [ "$old_host" != "$host" ]; then
        rm -f "$(tunnel_dir)/${old_host}" "$(tunnel_dir)/${old_host}.php"
    fi
    ln -sfn "../${relpath}" "$(tunnel_dir)/${host}"
    # Each `add` fixes the whole state as typed this time -- so a version
    # pinned before and not repeated now is dropped, not kept by accident.
    if [ -n "$ver" ]; then
        printf '%s\n' "$ver" > "$(tunnel_dir)/${host}.php"
    else
        rm -f "$(tunnel_dir)/${host}.php"
    fi

    # Replace any existing line for this name, then append.
    local tmp; tmp="$(mktemp)"
    grep -v "^${name}"$'\t' "$TUNNEL_SITES" > "$tmp" 2>/dev/null || true
    printf '%s\t%s\n' "$name" "$host" >> "$tmp"
    sort -o "$TUNNEL_SITES" "$tmp"; rm -f "$tmp"

    tunnel_write_config
    info "${host}  ->  ${name}"
    if is_on tunnel; then
        # `docker compose up -d` does not restart a container already running
        # just because a file it mounts changed -- compose has no way to see
        # that, so cloudflared would otherwise keep serving 404 for this
        # hostname with the old ingress table until something restarts it.
        info "Reloading the background tunnel"
        docker compose restart cloudflared >/dev/null
    else
        echo "  Start it:  forge tunnel on"
    fi
}

tunnel_rm() {
    local name tmp hostname
    name="${1:-}"
    [ -n "$name" ] || { err "usage: forge tunnel rm <name>"; exit 1; }
    [ -f "$TUNNEL_SITES" ] || { err "Nothing is mapped."; exit 1; }

    grep -q "^${name}"$'\t' "$TUNNEL_SITES" || { err "'$name' is not mapped."; exit 1; }
    hostname="$(awk -F'\t' -v s="$name" '$1 == s { print $2; exit }' "$TUNNEL_SITES")"

    tmp="$(mktemp)"
    grep -v "^${name}"$'\t' "$TUNNEL_SITES" > "$tmp" || true
    mv "$tmp" "$TUNNEL_SITES"

    rm -f "$(tunnel_dir)/${hostname}" "$(tunnel_dir)/${hostname}.php"

    tunnel_write_config
    info "Removed $name"
    if is_on tunnel; then
        info "Reloading the background tunnel"
        docker compose restart cloudflared >/dev/null
    fi
    # The DNS record is left alone on purpose: deleting it is not this command's
    # to guess at, and a stale CNAME to a tunnel simply stops resolving.
    warn "Its DNS record still exists. Remove it in the Cloudflare dashboard if you want it gone."
}

tunnel_status() {
    local name hostname ver
    if [ -f "$TUNNEL_SITES" ] && [ -s "$TUNNEL_SITES" ]; then
        while IFS=$'\t' read -r name hostname; do
            [ -n "${name:-}" ] || continue
            ver=""
            if [ -f "$(tunnel_dir)/${hostname}.php" ]; then
                ver=" (PHP $(pretty <<<"$(cat "$(tunnel_dir)/${hostname}.php")"))"
            fi
            printf '  https://%-40s -> %s%s\n' "$hostname" "$name" "$ver"
        done < "$TUNNEL_SITES"
    else
        echo "  nothing mapped yet   (forge tunnel add <folder> <hostname>)"
    fi

    # Anything else in .tunnel/ is not one of the rows above, so it can only
    # be a `forge tunnel` running right now in some other window -- it was
    # never added, and tunnel_clean() sweeps it the moment that window closes.
    local dir keep="" entry host target shown=0
    dir="$(tunnel_dir)"
    [ -f "$TUNNEL_SITES" ] && keep="$(awk -F'\t' '{print $2}' "$TUNNEL_SITES")"
    if [ -d "$dir" ]; then
        for entry in "$dir"/*; do
            [ -L "$entry" ] || continue
            host="$(basename "$entry")"
            grep -qxF "$host" <<<"$keep" && continue
            if [ "$shown" -eq 0 ]; then echo ""; echo "  running now, not added:"; shown=1; fi
            target="$(readlink "$entry")"
            ver=""
            [ -f "${entry}.php" ] && ver=" (PHP $(pretty <<<"$(cat "${entry}.php")"))"
            printf '  https://%-40s -> %s%s\n' "$host" "${target#../}" "$ver"
        done
    fi

    echo ""
    if is_on tunnel; then echo "  tunnel: ON"; else echo "  tunnel: off"; fi
    [ -f "${CLOUDFLARED_HOME}/cert.pem" ] || echo "  not logged in        (forge tunnel login)"
}

cmd_tunnel() {
    need_env
    case "${1:-}" in
        login)  info "A browser window will ask you to pick the domain to authorise"
                tunnel_cf tunnel login ;;
        add)    shift; tunnel_add "$@" ;;
        rm)     shift; tunnel_rm "$@" ;;
        on)     [ -f "$TUNNEL_CONFIG" ] || {
                    err "Nothing is mapped yet."
                    echo "  forge tunnel login && forge tunnel add <folder> <hostname>" >&2
                    exit 1; }
                need_login
                # If it was already on, `compose_up` below is a no-op -- the
                # rewrite the web server may have changed since still needs a
                # restart to actually reach the running container.
                local was_on=0; is_on tunnel && was_on=1
                tunnel_write_config
                cmd_profile on tunnel
                [ "$was_on" = 1 ] && docker compose restart cloudflared >/dev/null
                tunnel_status ;;
        off)    cmd_profile off tunnel ;;
        status) tunnel_status ;;
        -h|--help)
                echo "  forge tunnel [folder] [--php <v>]      a throwaway public URL, no account needed"
                echo "                                         (no folder: uses where you are standing)"
                echo "  forge tunnel login                     hand over your Cloudflare credentials"
                echo "  forge tunnel add <folder> [host] [--php <v>]"
                echo "                                         publish at a hostname that stays"
                echo "  forge tunnel rm <name>                  stop publishing it"
                echo "  forge tunnel on|off|status              the background tunnel" ;;
        *)      tunnel_quick "$@" ;;
    esac
}

cmd_certs() { need_env; ./install_cert.sh; }

# Teaching the AI agents on this machine how to drive all of the above. The file
# is one; only the wrapper differs per agent. See lib/skill.sh.
cmd_skill() {
    local targets; targets="$(skill_targets)"
    case "${1:-status}" in
        on)  shift
             if [ -z "$targets" ]; then
                 warn "No AI agent found on this machine."
                 echo "    Point yours at $(skill_path)"
                 exit 0
             fi
             skill_on "${1:-}" || { err "Unknown agent: ${1:-}"; exit 1; } ;;
        off) shift; skill_off "${1:-}" ;;
        path) skill_path ;;
        status|"")
             if [ -z "$targets" ]; then
                 echo "  no AI agent found; the file is $(skill_path)"
                 return 0
             fi
             local name kind path
             while IFS=$'\t' read -r name kind path; do
                 [ -n "$name" ] || continue
                 if skill_is_on "$kind" "$path"; then
                     printf '  %-9s ON   %s\n' "$name" "$path"
                 else
                     printf '  %-9s off  %s\n' "$name" "$path"
                 fi
             done <<EOF
$targets
EOF
             ;;
        *) err "forge skill [status|on|off|path] [agent]"; exit 1 ;;
    esac
}

cmd_dns() {
    need_env
    case "${1:-status}" in
        status|test|remove) ./setup-local-dns.sh "--$1" ;;
        setup)              ./setup-local-dns.sh ;;
        *) err "forge dns [setup|status|test|remove]"; exit 1 ;;
    esac
}

cmd_help() {
    cat <<EOF
PHP DevForge $(forge_version)

  forge --force <command>      take over containers another checkout started

  forge version                which PHP DevForge this is

  forge install [options]      set everything up (first run, or to reconfigure)
  forge uninstall [--dry-run]  undo it: containers, images, DNS, the trusted CA
  forge update [--edge]        move this checkout to the latest release

  forge start [service...]     start the environment
  forge stop  [service...]     stop it
  forge restart [service...]   recreate the containers
  forge status                 what is running, and how it is configured

  forge php list               the PHP versions, and which are installed
  forge php on|off <version>   install one, or free the disk it uses
  forge use <version>          set the default version (installs it if needed)
  forge run [-p V] [-C DIR] .. run a command in the PHP container
  forge shell [version]        open a shell in a PHP container
  forge logs  [version|service] follow the logs; everything if you name nothing

  forge link <folder> [name]   publish a project: symlinks it under sites/
  forge tunnel [folder] [--php <v>]  a public URL, to try on a real phone
  forge tunnel login|add|rm    the same over your own Cloudflare domain
  forge tunnel on|off|status   that one, in the background

  forge profile list [filter]  every optional service, what it starts, what is on
  forge profile on|off <name>  turn one on or off

  forge db list                the databases among them
  forge db on|off <name>       same thing, filtered to databases
  forge mail on|off            a mail catcher at mail.<domain>

  forge images build|pull      build images locally, or use the published ones
  forge certs                  regenerate the HTTPS certificates
  forge skill [on|off|path]    teach the AI agents here how to use all this
  forge dns [setup|status|test|remove]

PHP versions: $(installed_versions | pretty | commas) installed, out of $(php_versions | pretty | commas)
Version arguments accept either form: 8.5 or 85.
EOF
}

FORCE=0
if [ "${1:-}" = "--force" ]; then FORCE=1; shift; fi

case "${1:-help}" in
    install|uninstall|update) ;;
    *) check_for_update ;;
esac

case "${1:-help}" in
    install)   shift; cmd_install "$@" ;;
    uninstall) shift; cmd_uninstall "$@" ;;
    update)    shift; cmd_update "$@" ;;
    start)   shift; cmd_start "$@" ;;
    stop)    shift; cmd_stop "$@" ;;
    restart) shift; cmd_restart "$@" ;;
    status)  shift; cmd_status ;;
    php)     shift; cmd_php "$@" ;;
    use)     shift; cmd_use "$@" ;;
    run)     shift; cmd_run "$@" ;;
    shell)   shift; cmd_shell "$@" ;;
    logs)    shift; cmd_logs "$@" ;;
    link)    shift; cmd_link "$@" ;;
    tunnel)  shift; cmd_tunnel "$@" ;;
    profile) shift; cmd_profile "$@" ;;
    db)      shift; cmd_db "$@" ;;
    mail)    shift; cmd_mail "$@" ;;
    images)  shift; cmd_images "$@" ;;
    certs)   shift; cmd_certs ;;
    skill)   shift; cmd_skill "$@" ;;
    dns)     shift; cmd_dns "$@" ;;
    version|-v|--version) echo "PHP DevForge $(forge_version)" ;;
    help|-h|--help) cmd_help ;;
    *) err "Unknown command: $1"; echo ""; cmd_help; exit 1 ;;
esac
