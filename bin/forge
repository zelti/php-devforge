#!/usr/bin/env bash
#
# PHP DevForge command line.
#
# Works in any shell, unlike the aliases it replaces: those only worked in bash.
#
set -euo pipefail

FORGE_DIR="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
cd "$FORGE_DIR"

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; BLUE='\033[0;34m'; NC='\033[0m'
info() { echo -e "${GREEN}[OK]${NC} $1"; }
warn() { echo -e "${YELLOW}[!]${NC} $1"; }
err()  { echo -e "${RED}[ERROR]${NC} $1" >&2; }

# PHP versions come from the compose file, so adding php86dev is all it takes for
# `forge use 8.6` to work. Nothing here enumerates them.
versions() {
    docker compose config --services 2>/dev/null \
        | sed -n 's/^php\([0-9][0-9]\)dev$/\1/p' | sort
}

# Accepts 8.5 or 85; returns the compact form.
normalise() {
    local v="${1//./}"
    if ! printf '%s\n' "$(versions)" | grep -qx "$v"; then
        err "Unknown PHP version: $1"
        echo "  available: $(versions | sed 's/\(.\)\(.\)/\1.\2/' | tr '\n' ' ')" >&2
        exit 1
    fi
    echo "$v"
}

current_version() { sed -ne 's/^PHP_VERSION=\([0-9]*\)$/\1/p' .env 2>/dev/null; }

# Absent in .env files written before the setting existed; compose defaults it too.
image_mode() {
    local m; m="$(sed -ne 's/^IMAGE_MODE=//p' .env 2>/dev/null)"
    echo "${m:-missing (default)}"
}

need_env() {
    [ -f .env ] || { err "No .env here. Run ./install.sh first."; exit 1; }
}

pretty() { sed 's/\(.\)\(.\)/\1.\2/'; }

cmd_start()   { need_env; docker compose up -d "$@"; }
cmd_stop()    { need_env; docker compose stop "$@"; }
cmd_restart() { need_env; docker compose up -d --force-recreate "$@"; }

cmd_status() {
    need_env
    echo -e "${BLUE}PHP DevForge${NC}"
    echo "  domain:   *.$(sed -ne 's/^DEV_DOMAIN=//p' .env)"
    echo "  default:  PHP $(current_version | pretty)"
    echo "  images:   $(image_mode)"
    echo "  projects: $(sed -ne 's/^PROJECTS_DIR=//p' .env)"
    echo ""
    docker compose ps
}

cmd_use() {
    need_env
    [ $# -ge 1 ] || { err "Which version? e.g. forge use 8.5"; exit 1; }
    local v; v="$(normalise "$1")"
    sed -i "s/^PHP_VERSION=.*/PHP_VERSION=${v}/" .env
    info "Default is now PHP $(echo "$v" | pretty)"
    docker compose up -d
}

cmd_shell() {
    need_env
    local v; v="$(normalise "${1:-$(current_version)}")"
    # Keep your current directory when you are inside the projects folder.
    local wd="/home/php-devforge"
    case "$PWD" in *public_html*|"$(sed -ne 's/^PROJECTS_DIR=//p' .env)"*) wd="$PWD" ;; esac
    docker exec -it -w "$wd" -u php-devforge "php${v}dev" bash
}

cmd_logs() {
    need_env
    local v; v="$(normalise "${1:-$(current_version)}")"
    docker compose logs -f "php${v}dev"
}

cmd_images() {
    need_env
    case "${1:-}" in
        build)  sed -i 's/^IMAGE_MODE=.*/IMAGE_MODE=build/' .env
                info "Images will be built locally"; docker compose up -d ;;
        pull)   sed -i 's/^IMAGE_MODE=.*/IMAGE_MODE=missing/' .env
                info "Images will be pulled from ghcr.io"; docker compose up -d ;;
        status|"") echo "  IMAGE_MODE=$(image_mode)" ;;
        *) err "forge images [build|pull|status]"; exit 1 ;;
    esac
}

cmd_install() { ./install.sh "$@"; }

cmd_certs() { need_env; ./install_cert.sh; }

cmd_dns() {
    need_env
    case "${1:-status}" in
        status|test|remove) ./setup-local-dns.sh "--$1" ;;
        setup)              ./setup-local-dns.sh ;;
        *) err "forge dns [setup|status|test|remove]"; exit 1 ;;
    esac
}

cmd_help() {
    cat <<EOF
PHP DevForge

  forge install [options]      set everything up (first run, or to reconfigure)

  forge start [service...]     start the environment
  forge stop  [service...]     stop it
  forge restart [service...]   recreate the containers
  forge status                 what is running, and how it is configured

  forge use <version>          set the default PHP version
  forge shell [version]        open a shell in a PHP container
  forge logs  [version]        follow a container's logs

  forge images build|pull      build images locally, or use the published ones
  forge certs                  regenerate the HTTPS certificates
  forge dns [setup|status|test|remove]

Versions available here: $(versions | pretty | tr '\n' ' ')
Version arguments accept either form: 8.5 or 85.
EOF
}

case "${1:-help}" in
    install) shift; cmd_install "$@" ;;
    start)   shift; cmd_start "$@" ;;
    stop)    shift; cmd_stop "$@" ;;
    restart) shift; cmd_restart "$@" ;;
    status)  shift; cmd_status ;;
    use)     shift; cmd_use "$@" ;;
    shell)   shift; cmd_shell "$@" ;;
    logs)    shift; cmd_logs "$@" ;;
    images)  shift; cmd_images "$@" ;;
    certs)   shift; cmd_certs ;;
    dns)     shift; cmd_dns "$@" ;;
    help|-h|--help) cmd_help ;;
    *) err "Unknown command: $1"; echo ""; cmd_help; exit 1 ;;
esac
