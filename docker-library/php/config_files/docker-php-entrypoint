#!/bin/bash -
set -e

HOMEDIR="/home/php-devforge"
BASHRC_PHP_DEVFORGE="/usr/local/php-devforge/bashrc"
NVM_DIR="${NVM_DIR:-/usr/local/nvm}"
PUID="${PUID:-1000}"
PGID="${PGID:-1000}"

# Match the container user to the host user, so files created in here belong to
# you outside. Without this you cannot delete node_modules without sudo.
cur_uid="$(id -u php-devforge)"
cur_gid="$(id -g php-devforge)"

if [ "$cur_gid" != "$PGID" ]; then
  groupmod -o -g "$PGID" php-devforge
fi
if [ "$cur_uid" != "$PUID" ]; then
  usermod -o -u "$PUID" php-devforge
fi

# Checked on every start, not only when the uid changes: a named volume keeps
# the ownership it was created with, which may come from an older build.
fix_owner() {
  [ -e "$1" ] || return 0
  if [ "$(stat -c %u "$1")" != "$PUID" ] || [ "$(stat -c %g "$1")" != "$PGID" ]; then
    chown -R php-devforge:php-devforge "$1" 2>/dev/null || true
  fi
}

# nvm lives outside the home dir, so usermod does not fix it. Without this,
# `nvm install` and global npm/pnpm packages fail.
fix_owner "$NVM_DIR"

# public_html is the mounted host folder: never touch its ownership.
chown php-devforge:php-devforge "$HOMEDIR" 2>/dev/null || true
# Apache is a different uid and still has to traverse this to reach public_html.
chmod 755 "$HOMEDIR" 2>/dev/null || true
find "$HOMEDIR" -mindepth 1 -maxdepth 1 ! -name public_html \
  -exec chown -R php-devforge:php-devforge {} + 2>/dev/null || true

# Load the shared bashrc for both the dev user and root.
for f in "$HOMEDIR/.bashrc" /root/.bashrc; do
  [ -f "$f" ] || continue
  grep -Fxq "### CUSTOM PHP-DEVFORGE BLOCK ###" "$f" && continue
  {
    echo ""
    echo "### CUSTOM PHP-DEVFORGE BLOCK ###"
    echo "if [ -f \"$BASHRC_PHP_DEVFORGE\" ]; then"
    echo "  . \"$BASHRC_PHP_DEVFORGE\""
    echo "fi"
    echo "### END CUSTOM PHP-DEVFORGE BLOCK ###"
  } >> "$f"
done

if [ "$PHP_XDEBUG" == "yes" ]; then
  /usr/local/bin/xdebug --force-activate
fi

if [ -s "$HOMEDIR/script/cron_php-devforge" ]; then
  chown php-devforge:php-devforge "$HOMEDIR/script/cron_php-devforge"
  crontab -u php-devforge "$HOMEDIR/script/cron_php-devforge"
fi

if [ ! -d /run/php ]; then
  mkdir -p /run/php
fi
chown php-devforge:php-devforge /run/php

if [ ! -d "$HOMEDIR/public_html" ]; then
  mkdir -p "$HOMEDIR/public_html"
fi

rm -f /run/cron*
/usr/sbin/cron

# Trust the local CA inside the container, so PHP calling another local site over
# HTTPS does not fail with "cURL error 60".
if [ -f /caroot/rootCA.pem ]; then
  if ! cmp -s /caroot/rootCA.pem /usr/local/share/ca-certificates/php-devforge-ca.crt; then
    install -m 644 /caroot/rootCA.pem /usr/local/share/ca-certificates/php-devforge-ca.crt
    update-ca-certificates >/dev/null 2>&1 || true
  fi
fi

# first arg is `-f` or `--some-option`
if [ "${1#-}" != "$1" ]; then
  set -- php-fpm "$@"
fi

# Runs as root on purpose: the php-fpm master needs it to drop workers to the
# dev user (see zz-docker.conf). Workers never run as root.
exec "$@"
